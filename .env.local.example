NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# NUNCA se expone al navegador ni se commitea. Además de crear los usuarios con
# `npm run seed:users`, el servidor la usa para push, métricas de admin, el login con huella y
# el bloqueo de la app (firma la cookie que prueba que se mostró la huella hace poco). Sin esta
# clave, el bloqueo queda desactivado en vez de trabar la app.
# La service role key está en Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SEED_PASSWORD=

# Push (VAPID) y cron
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
CRON_SECRET=
